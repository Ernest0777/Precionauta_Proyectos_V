# Mercado Libre Credentials
# Obtén tus credenciales en: https://apps.mercadolibre.com
MERCADO_LIBRE_APP_ID=your_app_id_here
MERCADO_LIBRE_ACCESS_TOKEN=your_token_here
MERCADO_LIBRE_USER_ID=your_user_id_here
# Con la clave secreta (y "Client Credentials" activado en la app) el backend
# pide un token nuevo solo cuando vence (cada 6 h). El refresh token es opcional.
MERCADO_LIBRE_CLIENT_SECRET=your_client_secret_here
MERCADO_LIBRE_REFRESH_TOKEN=your_refresh_token_here
# La misma URL que registraste en tu app de ML (la usa scripts/meli-token.js)
MERCADO_LIBRE_REDIRECT_URI=https://www.google.com

# Server Configuration
PORT=3001
NODE_ENV=development

# Optional: Logging level (debug, info, warn, error)
LOG_LEVEL=info
