# Mercado Libre Credentials
# Obtén tus credenciales en: https://apps.mercadolibre.com
MERCADO_LIBRE_APP_ID=your_app_id_here
MERCADO_LIBRE_ACCESS_TOKEN=your_token_here
MERCADO_LIBRE_USER_ID=your_user_id_here
# Con la clave secreta (y "Client Credentials" activado en la app) el backend
# pide un token nuevo solo cuando vence (cada 6 h). El refresh token es opcional.
MERCADO_LIBRE_CLIENT_SECRET=your_client_secret_here
MERCADO_LIBRE_REFRESH_TOKEN=your_refresh_token_here
# La misma URL que registraste en tu app de ML (la usa scripts/meli-token.js)
MERCADO_LIBRE_REDIRECT_URI=https://www.google.com

# Panel de administración (http://localhost:3001/admin)
# Sin ADMIN_PASSWORD el panel no deja entrar. ADMIN_SECRET es opcional:
# si lo pones, la sesión sigue viva aunque reinicies el servidor.
ADMIN_PASSWORD=your_admin_password_here
ADMIN_SECRET=your_long_random_string_here

# Afiliados de Mercado Libre: los parámetros que te da el programa al aprobarte,
# tal cual van en el enlace (ejemplo de formato, no reales):
MELI_AFFILIATE_PARAMS=your_affiliate_params_here

# Alertas por Telegram: crea un bot con @BotFather y pega aquí su token.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# URL pública del backend cuando ya esté en internet (los avisos de Telegram
# enlazan a /go/:id para contar el clic). En local déjala vacía.
PUBLIC_URL=

# Server Configuration
PORT=3001
NODE_ENV=development

# Optional: Logging level (debug, info, warn, error)
LOG_LEVEL=info
